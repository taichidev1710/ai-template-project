# Public runtime config — only VITE_* vars are exposed to the client.

# Base path for API calls. The be-template backend serves under /api/v1.
# - Dev: keep "/api/v1"; the Vite proxy (see vite.config.ts) forwards it to the
#   backend, so there is no browser CORS to deal with.
# - Production (e.g. GitHub Pages, no proxy): set the FULL backend URL, e.g.
#   VITE_API_BASE_URL=https://be-template-vk71.onrender.com/api/v1
#   and make sure the backend's CORS_ORIGINS includes this site's origin.
VITE_API_BASE_URL=/api/v1

VITE_APP_NAME=Admin Dashboard
VITE_ENABLE_DEVTOOLS=true

# Dev only: override where the Vite proxy sends /api. Defaults to
# http://localhost:3000 (local backend). Point at Render to skip running it:
# VITE_API_PROXY_TARGET=https://be-template-vk71.onrender.com
